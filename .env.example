# ---------------------------------------------------------------------------
# Database (Supabase Postgres / PostgreSQL 15+)
# ---------------------------------------------------------------------------
# DIRECT_URL is used for migrations and the seed and should use the direct
# connection (IPv6) or the session pooler. DATABASE_URL is used at runtime;
# serverless hosts such as Netlify need the IPv4 transaction pooler
# (port 6543) because Lambda cannot reach the IPv6-only direct host.
#
# Local/self-hosted TLS: sslmode=verify-full with the committed Supabase CA.
# Serverless TLS: set DATABASE_SSL_CA to the PEM contents of
# certs/supabase-ca-chain.crt and omit sslrootcert (the file is not present in
# the function bundle). See docs/DEPLOYMENT.md.
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=verify-full&sslrootcert=./certs/supabase-ca-chain.crt"
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=verify-full&sslrootcert=./certs/supabase-ca-chain.crt"

# Optional: PEM CA chain for serverless runtimes. Supports literal \n escapes.
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# Optional: node-postgres pool size per process (default 10). Use 2-3 on
# serverless platforms.
# DATABASE_POOL_MAX="3"

# ---------------------------------------------------------------------------
# Auth.js
# Generate with: openssl rand -base64 32
# ---------------------------------------------------------------------------
AUTH_SECRET="replace-with-a-random-32-byte-secret"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
COMPANY_TIMEZONE="Asia/Kolkata"
# Password assigned to every seeded demo account. Required only by
# `prisma db seed` (minimum 12 characters). Never commit the real value.
SEED_PASSWORD=""
# "filesystem" (default, persistent disk/volume) or "database" (serverless).
# Netlify has an ephemeral filesystem, so it must use "database".
ATTACHMENT_STORAGE="filesystem"
UPLOAD_DIR="./storage/attachments"
MAX_UPLOAD_MB="10"
